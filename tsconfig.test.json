{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "cdk/**/__tests__/**/*",
    "cdk/**/*.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
