# TDnet Data Collector - 環境変数サンプル
# このファイルをコピーして .env.local または .env.production を作成してください

# ==========================================
# AWS リソース設定
# ==========================================

# S3バケット名（PDFファイル保存先）
S3_BUCKET_NAME=tdnet-pdfs-prod

# DynamoDBテーブル名（開示情報メタデータ）
DYNAMODB_TABLE_NAME=tdnet-disclosures

# DynamoDBテーブル名（実行状態管理）
DYNAMODB_EXECUTIONS_TABLE=tdnet-executions

# AWSリージョン
AWS_REGION=ap-northeast-1

# ==========================================
# ログ設定
# ==========================================

# ログレベル（debug, info, warn, error）
LOG_LEVEL=info

# ==========================================
# TDnet設定
# ==========================================

# TDnetベースURL（オプション）
# デフォルト: https://www.release.tdnet.info
# 環境変数で上書き可能（テスト環境やモックサーバー使用時）
# TDNET_BASE_URL=https://www.release.tdnet.info

# ==========================================
# API設定（Phase 2以降）
# ==========================================

# API Gateway URL
# API_ENDPOINT=https://[API_GATEWAY_ID].execute-api.ap-northeast-1.amazonaws.com/prod

# APIキーシークレット名（Secrets Manager）
# API_KEY_SECRET_NAME=tdnet-api-key

# ==========================================
# 定数設定（オプション）
# ==========================================
# 以下の定数は src/constants/ で定義されており、通常は変更不要です。
# 特別な理由がある場合のみ環境変数で上書きできます。

# HTTPタイムアウト（ミリ秒）
# デフォルト: 30000 (30秒)
# HTTP_TIMEOUT_MS=30000

# レート制限（ミリ秒）
# デフォルト: 2000 (2秒)
# TDNET_MIN_DELAY_MS=2000

# PDFファイル最小サイズ（バイト）
# デフォルト: 10240 (10KB)
# MIN_PDF_SIZE=10240

# PDFファイル最大サイズ（バイト）
# デフォルト: 52428800 (50MB)
# MAX_PDF_SIZE=52428800

# ==========================================
# LocalStack設定（開発・テスト環境のみ）
# ==========================================

# LocalStackエンドポイント
# LOCALSTACK_ENDPOINT=http://localhost:4566

# LocalStack使用フラグ
# USE_LOCALSTACK=true
